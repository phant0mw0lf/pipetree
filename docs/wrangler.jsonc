{
  // Cloudflare Workers static assets: serves the built site from dist/.
  // `name` must match the project name in Cloudflare.
  "name": "pipetree",
  "compatibility_date": "2026-10-10",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Enables `wrangler preview` for branch and pull request previews.
  "previews": {}
}
